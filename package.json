{
  "name": "yori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:test": "tsc --noEmit && vite build --mode test --outDir dist-test",
    "preview": "vite preview",
    "preview:test": "vite preview --outDir dist-test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:golden": "vitest run tests/golden",
    "test:drills": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify:production": "node scripts/verify-production-build.ts",
    "verify:live:spark": "vite-node scripts/live-verify-spark.ts",
    "verify:live:xmemo": "vite-node scripts/live-verify-xmemo.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.8.2",
    "vite": "^7.3.7",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/newsreader": "5.3.0"
  }
}
