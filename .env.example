# ==============================================================================
# Yori Environment Variables Template
# Copy this file to .env.local to configure local development.
# IMPORTANT: .env.local is ignored by git and must NEVER be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Meta Model API (muse-spark-1.3) Configuration
# ------------------------------------------------------------------------------
# Your Meta Model API key for Muse Spark reasoning (keep private!)
# MODEL_API_KEY="your-meta-api-key-here"

# Model identifier (default: muse-spark-1.3)
# MODEL_NAME="muse-spark-1.3"

# Endpoint base URL (strict host allowlist: api.meta.ai only)
# MODEL_BASE_URL="https://api.meta.ai/v1"

# Per-Run Call Cap: 1..10 calls maximum per verification session (S1-CAP50).
# Refuses to start if requested cap exceeds remaining lifetime calls.
# Lifetime allowance: 50 calls total across all runs (MODEL_LIFETIME_MAX_CALLS = 50).
# MODEL_LIVE_MAX_CALLS=10

# Per-Call Output Token Ceiling: 1..8192 (clamped to MAX_TOKENS_CEILING = 8192).
# Unset / empty falls back to safe per-endpoint defaults (150 refine / 250 reason / 300 command).
# Generous override for reasoning headroom: e.g. 2048 or 4096.
# MODEL_MAX_TOKENS=2048

# Reasoning Effort Throttling: optional depth control for internal chain-of-thought.
# Supported values: 'minimal', 'low', 'medium', 'high', 'xhigh', 'max'.
# Note: 'none' is rejected by Meta reasoning models with HTTP 400.
# Unset by default to avoid HTTP 400 rejection risks on untested endpoints.
# MODEL_REASONING_EFFORT="low"

# Request timeout in milliseconds (clamped to [500, 20000]; default 2000).
# MODEL_TIMEOUT_MS=20000

# DO NOT set MODEL_LIVE_ENABLED in .env.local!
# Keep MODEL_LIVE_ENABLED unset (or 0) for normal development to prevent accidental billed calls.
# Pass MODEL_LIVE_ENABLED=1 inline only during authorized verification sessions.

# ------------------------------------------------------------------------------
# XMemo Memory Integration (OAuth 2.0 / PKCE)
# ------------------------------------------------------------------------------
# Keep false during development; sovereign local browser memory is active truth.
# XMEMO_OAUTH_ENABLED=false

# ------------------------------------------------------------------------------
# Live Weather Integration
# ------------------------------------------------------------------------------
# Keep false during development; deterministic fixtures are active truth.
# WEATHER_LIVE_ENABLED=false
